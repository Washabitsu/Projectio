# Copy to .env and fill in. The .env file is ignored by git.

ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=Projectio;Trusted_Connection=True;TrustServerCertificate=True
IsDevelopment=true

# Tokens. SigningKey is an RSA private key (PKCS#8, base64 on one line). Create one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
Jwt__Issuer=Projectio
Jwt__Audience__0=ProjectioClient
Jwt__SigningKey=
Jwt__TokenTimeoutMinutes=15

# Applications that may log users in through Projectio. The secret must match Auth__ClientSecret in Portio
Clients__0__ClientId=portio-bff
Clients__0__ClientSecret=
Clients__0__RedirectUri=https://localhost:7287/bff/callback

Frontend__Url=https://localhost:7287

# Google sign-in. RedirectUris__0 is the callback path on Projectio:
# register https://localhost:7287/api/auth/google/callback at Google (Portio's address: it passes the callback through)
Google__ClientId=
Google__ProjectId=
Google__AuthUri=https://accounts.google.com/o/oauth2/auth
Google__TokenUri=https://oauth2.googleapis.com/token
Google__AuthProviderX509CertUrl=https://www.googleapis.com/oauth2/v1/certs
Google__ClientSecret=
Google__RedirectUris__0=/api/auth/google/callback
